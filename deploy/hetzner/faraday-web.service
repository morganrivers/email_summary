[Unit]
Description=Faraday web UI
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/email_summary
ExecStart=/opt/email_summary/venv/bin/python -m frontend.web_server
Restart=always
RestartSec=5
EnvironmentFile=/opt/email_summary/.env
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
