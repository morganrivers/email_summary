[Unit]
Description=Email drafter daemon (FIFO wake -> draft replies)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/email_summary
ExecStart=/opt/email_summary/venv/bin/python /opt/email_summary/daemon_loop.py
Restart=always
RestartSec=3
Environment=PATH=/opt/email_summary/venv/bin:/usr/local/bin:/usr/bin:/bin
SyslogIdentifier=email-daemon

[Install]
WantedBy=multi-user.target
