[Unit]
Description=Email drafter daemon (FIFO wake -> draft replies)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/letterlock
ExecStart=/opt/letterlock/venv/bin/python -m backend.daemons.daemon_loop
Restart=always
RestartSec=3
Environment=PATH=/opt/letterlock/venv/bin:/usr/local/bin:/usr/bin:/bin
SyslogIdentifier=email-daemon

[Install]
WantedBy=multi-user.target
