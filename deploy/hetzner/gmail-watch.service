[Unit]
Description=Renew Gmail users.watch for every active account (Pub/Sub push registration)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/email_summary
ExecStart=/opt/email_summary/venv/bin/python /opt/email_summary/watch_renew.py
Environment=GMAIL_MCP_DIR=/opt/email_summary/.gmail-mcp
Environment=PATH=/opt/email_summary/venv/bin:/usr/local/bin:/usr/bin:/bin
SyslogIdentifier=gmail-watch
