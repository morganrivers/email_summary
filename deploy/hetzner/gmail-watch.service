[Unit]
Description=Renew Gmail users.watch for every active account (Pub/Sub push registration)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/letterlock
ExecStart=/opt/letterlock/venv/bin/python -m backend.onboarding.watch_renew
Environment=PATH=/opt/letterlock/venv/bin:/usr/local/bin:/usr/bin:/bin
SyslogIdentifier=gmail-watch
