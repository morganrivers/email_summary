# Not timer-driven. The schedule is backend/daemons/scheduler.py, a thread in
# email-daemon.service; this unit is the sandboxed way to run the same job by
# hand (`systemctl start email-summary.service`). tests/test_scheduler.py asserts
# this ExecStart against what the scheduler calls, so the two cannot drift.
[Unit]
Description=Daily email summary -> Telegram
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/letterlock
ExecStart=/opt/letterlock/venv/bin/python -m backend.drafting.email_summary
Environment=PATH=/opt/letterlock/venv/bin:/usr/local/bin:/usr/bin:/bin
SyslogIdentifier=email-summary
