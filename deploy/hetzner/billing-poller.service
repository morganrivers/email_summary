[Unit]
Description=Reconcile Polar subscriptions into account plan_status (billing safety net)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/email_summary
ExecStart=/opt/email_summary/venv/bin/python /opt/email_summary/billing_poller.py
Environment=PATH=/opt/email_summary/venv/bin:/usr/local/bin:/usr/bin:/bin
SyslogIdentifier=billing-poller
