# Not timer-driven. The schedule is backend/daemons/scheduler.py, a thread in
# email-daemon.service; this unit is the sandboxed way to run the same job by
# hand (`systemctl start billing-poller.service`). tests/test_scheduler.py asserts
# this ExecStart against what the scheduler calls, so the two cannot drift.
[Unit]
Description=Reconcile Polar subscriptions into account plan_status (billing safety net)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/letterlock
ExecStart=/opt/letterlock/venv/bin/python -m backend.billing.billing_poller
Environment=PATH=/opt/letterlock/venv/bin:/usr/local/bin:/usr/bin:/bin
SyslogIdentifier=billing-poller
