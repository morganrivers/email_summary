[Unit]
Description=Polar billing webhook (Caddy -> 127.0.0.1:8789 -> account plan gating)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/letterlock
ExecStart=/opt/letterlock/venv/bin/python -m backend.billing.billing_webhook
Restart=always
RestartSec=3
SyslogIdentifier=billing-webhook

[Install]
WantedBy=multi-user.target
