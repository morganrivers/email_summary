[Unit]
Description=Gmail push webhook receiver (Caddy -> 127.0.0.1:8787 -> FIFO)
After=network-online.target email-daemon.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/email_summary
ExecStart=/opt/email_summary/venv/bin/python -m backend.daemons.gmail_hook_server
Restart=always
RestartSec=3
SyslogIdentifier=email-webhook

[Install]
WantedBy=multi-user.target
