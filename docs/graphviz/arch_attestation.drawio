geometry"><Array as="points"><mxPoint x="746" y="103"/><mxPoint x="788" y="126"/></Array></mxGeometry></mxCell><mxCell id="e7" value="5. all checks pass -&gt; unseal" style="edgeStyle=none;curved=1;html=1;endArrow=block;endFill=1;strokeColor=#9aa6b3;fontSize=9;fontColor=#5b6675;strokeColor=#c17a3a;dashed=1;" edge="1" parent="1" source="verifier" target="tokenstore"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="835" y="220"/><mxPoint x="810" y="246"/></Array></mxGeometry></mxCell><mxCell id="e8" value="6. token encrypted to enclave pubkey" style="edgeStyle=none;curved=1;html=1;endArrow=block;endFill=1;strokeColor=#9aa6b3;fontSize=9;fontColor=#5b6675;strokeColor=#3d72b4;dashed=1;" edge="1" parent="1" source="tokenstore" target="ekey"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="622" y="258"/><mxPoint x="542" y="234"/><mxPoint x="542" y="234"/><mxPoint x="542" y="234"/><mxPoint x="362" y="234"/><mxPoint x="362" y="234"/><mxPoint x="362" y="234"/><mxPoint x="327" y="252"/></Array></mxGeometry></mxCell><mxCell id="e9" value="token usable only in-enclave" style="edgeStyle=none;curved=1;html=1;endArrow=block;endFill=1;strokeColor=#9aa6b3;fontSize=9;fontColor=#5b6675;strokeColor=#2e8b57;" edge="1" parent="1" source="ekey" target="app"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="223" y="347"/><mxPoint x="216" y="376"/></Array></mxGeometry></mxCell><mxCell id="e10" value="7. fetch RAW email" style="edgeStyle=none;curved=1;html=1;endArrow=block;endFill=1;strokeColor=#9aa6b3;fontSize=9;fontColor=#5b6675;strokeColor=#2e8b57;" edge="1" parent="1" source="app" target="gmail"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="173" y="461"/><mxPoint x="149" y="487"/></Array></mxGeometry></mxCell><mxCell id="e11" value="8. MASKED only" style="edgeStyle=none;curved=1;html=1;endArrow=block;endFill=1;strokeColor=#9aa6b3;fontSize=9;fontColor=#5b6675;strokeColor=#1e7a3a;strokeWidth=2;" edge="1" parent="1" source="app" target="llm"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="236" y="461"/><mxPoint x="261" y="487"/></Array></mxGeometry></mxCell><object label="Verifier / KMS&lt;br&gt;checks quote, releases secrets" tooltip="" id="verifier"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e6d6f2;strokeColor=#8a5fb0;fontColor=#3d2757;" vertex="1" parent="1"><mxGeometry x="764" y="149" width="226" height="52" as="geometry"/></mxCell></object><object label="Intel / AMD&lt;br&gt;root certificate (public key)" tooltip="" id="intel"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=45;fillColor=#2f7dc4;strokeColor=#1c4f80;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="770" y="24" width="219" height="52" as="geometry"/></mxCell></object><object label="Published open-source&lt;br&gt;reproducible build =&lt;br&gt;expected measurement" tooltip="" id="pubhash"><mxCell style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fdf3cf;strokeColor=#c9a227;fontColor=#5b4a00;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="567" y="16" width="166" height="68" as="geometry"/></mxCell></object><object label="Sealed OAuth token&lt;br&gt;encrypted at rest" tooltip="" id="tokenstore"><mxCell style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#e6ecf3;strokeColor=#8493a4;fontColor=#1b2733;fontSize=11;" vertex="1" parent="1"><mxGeometry x="685" y="274" width="150" height="52" as="geometry"/></mxCell></object><object label="Untrusted host / operator&lt;br&gt;controls network: can replay or&lt;br&gt;reroute, but cannot forge a quote" tooltip="" id="host"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f6c9c0;strokeColor=#c0392b;fontColor=#5a1a12;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1006" y="266" width="245" height="68" as="geometry"/></mxCell></object><object label="CPU root of trust&lt;br&gt;measures + signs the quote" tooltip="" id="chip"><mxCell style="round